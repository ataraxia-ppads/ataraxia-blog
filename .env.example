# Modelo de variáveis de ambiente.
#
# Nada aqui é obrigatório em desenvolvimento: sem um `.env`, o projeto roda com
# SQLite e DEBUG ligado. Copie para `.env` só se precisar mudar algo.
#
#     cp .env.example .env
#
# O arquivo `.env` não é versionado.

# Em produção precisa ser False.
DJANGO_DEBUG=True

# Obrigatória quando DJANGO_DEBUG=False. Gere com:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# Domínios que o Django aceita atender, separados por vírgula.
DJANGO_ALLOWED_HOSTS=

# Origens confiáveis para envio de formulário, separadas por vírgula.
DJANGO_CSRF_TRUSTED_ORIGINS=

# Sem esta variável o projeto usa SQLite, que é o caso em desenvolvimento.
# Definindo-a, passa a usar o banco apontado por ela.
#   DATABASE_URL=postgres://usuario:senha@host:5432/banco
DATABASE_URL=
